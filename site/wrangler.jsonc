// The league website (thedynastycfb.com). Deployed by .github/workflows/deploy-site.yml
// whenever site/public changes. Same Cloudflare Worker (pf-07) that used to be uploaded by hand.
{
  "name": "pf-07",
  "account_id": "94040c1270d9dc5406fa79b47377f21f",
  "compatibility_date": "2026-11-16",
  "main": "worker.js",
  // Static site; the Worker only runs for paths with no matching file (e.g. /api/...)
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Breakaway arcade league leaderboard (SQLite-backed Durable Object, see worker.js)
  // + Ball Knower University trivia leaderboard (TriviaBoard)
  "durable_objects": { "bindings": [{ "name": "LEADERBOARD", "class_name": "Leaderboard" }, { "name": "TRIVIA", "class_name": "TriviaBoard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Leaderboard"] }, { "tag": "v2", "new_sqlite_classes": ["TriviaBoard"] }],
  "workers_dev": true
  // thedynastycfb.com + www are attached in the dashboard (Domains); deploys leave them alone
}
